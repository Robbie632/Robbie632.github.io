{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for Xdebug",
      "type": "php",
      "request": "launch",
      "port": 9003, // Default Xdebug port, adjust if needed
      "pathMappings": {
      "${workspaceFolder}" : "${workspaceFolder}", // Map server path to workspace

      },

    },
    {
      "name": "Run js file",
      "program": "${file}",
      "request": "launch",
      "type": "node"
    }
  ]
}
